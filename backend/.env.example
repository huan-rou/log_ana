# ── Log Analyzer 配置文件 ──
# 复制此文件为 .env 并修改其中的值
# 所有变量可被同名的环境变量覆盖

# ── 应用基础 ──
LA_DEBUG=true
LA_HOST=127.0.0.1
LA_PORT=8000

# ── 数据库 ──
LA_DATABASE_URL=sqlite+aiosqlite:///./data/log_analyzer.db
# WAL 性能更好；若 Windows/网络盘/安全软件导致 -wal/-shm I/O 错误，可临时改为 DELETE 验证
LA_SQLITE_JOURNAL_MODE=WAL
LA_SQLITE_BUSY_TIMEOUT_MS=30000
LA_SQLITE_TEMP_STORE=MEMORY
LA_DB_DIAGNOSTICS_ENABLED=true
# 仅在需要时打开；它会额外启动 sqlite3 只读连接，写入期间可能看到 database is locked
LA_DB_DIRECT_PROBE_ENABLED=false
LA_DB_DIAGNOSTICS_LOG_FILE=./data/db_diagnostics.log

# ── S3 / RustFS ──
# 启用后，连接 S3 兼容存储读取日志文件
LA_S3_ENABLED=false
LA_S3_ENDPOINT_URL=
LA_S3_ACCESS_KEY=
LA_S3_SECRET_KEY=
LA_S3_BUCKET=ci-logs
LA_S3_PREFIX=automation
LA_S3_REGION=us-east-1

# ── 审计日志 ──
# 以 JSON Lines 格式记录流水线的完整执行过程（S3 I/O、规则调用、分类决策）
LA_AUDIT_ENABLED=true
LA_AUDIT_DIR=./data/audit

# ── 规则引擎 ──
# serial  = 按优先级串行，首次匹配即停止
# parallel = 所有规则并行执行，取最高优先级/置信度
LA_RULE_EXECUTION_MODE=parallel
LA_RULE_FIRST_MATCH_WINS=true
